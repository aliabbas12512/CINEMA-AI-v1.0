# =====================================================================
# AI Fantasy Studio - environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# Every variable below is read by src/server/env.ts.
# =====================================================================

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Database (PostgreSQL; Supabase Postgres works - use its connection string)
DATABASE_URL=postgres://studio:studio@127.0.0.1:5432/studio
DATABASE_SSL=false

# ---- Redis (BullMQ job queue + rate limiting)
REDIS_URL=redis://127.0.0.1:6379

# ---- Sessions (generate with: openssl rand -base64 48)
SESSION_SECRET=replace-with-at-least-32-random-characters
ALLOW_SIGNUP=true

# ---- Storage: "local" (dev / single node) or "s3" (AWS S3, Supabase Storage S3, R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Supabase: S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SEC=3600

# ---- FFmpeg
WORK_DIR=./tmp/work
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Script analysis / planning (Anthropic Claude)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Images: character/location references + shot keyframes (Runway)
IMAGE_PROVIDER=none            # runway | none
IMAGE_PROVIDER_API_KEY=
IMAGE_MODEL=gen4_image         # gen4_image | gen4_image_turbo

# ---- Video: image-to-video (Runway)
VIDEO_PROVIDER=none            # runway | none
VIDEO_PROVIDER_API_KEY=
VIDEO_MODEL=gen4.5             # gen4.5 | veo3.1 | veo3.1_fast
VIDEO_FALLBACK_PROVIDER=none   # runway | none (uses VIDEO_PROVIDER_API_KEY)
VIDEO_FALLBACK_MODEL=

# ---- Urdu voice (Azure AI Speech ur-PK neural voices, or ElevenLabs)
VOICE_PROVIDER=none            # azure | elevenlabs | none
VOICE_PROVIDER_API_KEY=
VOICE_FALLBACK_PROVIDER=none   # azure | elevenlabs | none
VOICE_FALLBACK_API_KEY=
AZURE_SPEECH_REGION=           # e.g. eastus, centralindia
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_NARRATOR_VOICE_ID=  # voice ids from YOUR ElevenLabs voice library
ELEVENLABS_MALE_VOICE_IDS=     # comma-separated
ELEVENLABS_FEMALE_VOICE_IDS=   # comma-separated

# ---- Music (ElevenLabs Music)
MUSIC_PROVIDER=none            # elevenlabs | none
MUSIC_PROVIDER_API_KEY=

# ---- Sound effects (ElevenLabs Sound Effects)
SFX_PROVIDER=none              # elevenlabs | none
SFX_PROVIDER_API_KEY=

# ---- Lip sync (sync.)
LIPSYNC_PROVIDER=none          # sync | none
LIPSYNC_PROVIDER_API_KEY=
LIPSYNC_MODEL=lipsync-2

# ---- Pipeline tuning
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=2000
PROVIDER_POLL_INTERVAL_MS=5000
PROVIDER_TASK_TIMEOUT_SEC=1800
IMAGE_CONCURRENCY=3
VIDEO_CONCURRENCY=3
VOICE_CONCURRENCY=4
AUDIO_CONCURRENCY=3
WORKER_CONCURRENCY=2

# ---- Limits
MAX_SCRIPT_CHARS=60000
RATE_LIMIT_GENERATIONS_PER_HOUR=10
RATE_LIMIT_AUTH_PER_15MIN=20
