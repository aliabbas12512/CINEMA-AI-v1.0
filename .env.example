# =====================================================================
# AI Fantasy Studio - environment configuration
# Copy to .env and fill in. NEVER commit .env or real secrets.
# Every variable below is read by src/server/env.ts.
# (Comments are on their own lines: inline comments are not portable
#  across .env parsers.)
# =====================================================================

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Database (PostgreSQL; a Supabase Postgres connection string also works)
DATABASE_URL=postgres://studio:studio@127.0.0.1:5432/studio
DATABASE_SSL=false

# ---- Redis (BullMQ job queue + rate limiting)
REDIS_URL=redis://127.0.0.1:6379

# ---- Sessions. Generate with: openssl rand -base64 48
SESSION_SECRET=
ALLOW_SIGNUP=true

# ---- Storage: local (dev / single node) or s3 (AWS S3, Supabase Storage S3, R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Supabase example: https://<project_ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SEC=3600

# ---- FFmpeg
WORK_DIR=./tmp/work
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# =====================================================================
# REQUIRED PROVIDERS FOR A COMPLETE FILM (no Runway needed)
# =====================================================================

# ---- 1) Story analysis / scene planning: Anthropic Claude
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- 2) Urdu voice: Azure AI Speech (ur-PK-AsadNeural / ur-PK-UzmaNeural)
# Setting SPEECH_KEY selects Azure automatically. SPEECH_REGION is your
# Speech resource region, e.g. eastus, westeurope, centralindia.
SPEECH_KEY=
SPEECH_REGION=

# ---- 3) Images (character/location references + shot keyframes)
# cloudflare = Cloudflare Workers AI, 10,000 free Neurons/day (~170 images/day
# with flux-1-schnell). Token needs "Workers AI - Read" and "Workers AI - Edit".
# Setting both Cloudflare values selects it automatically.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: @cf/black-forest-labs/flux-1-schnell (default) or @cf/leonardo/lucid-origin
IMAGE_MODEL=

# ---- 4) Video
# ffmpeg_motion = local cinematic camera motion over the AI keyframes.
# No account, no payment. (Not generative motion: the camera moves, characters do not.)
VIDEO_PROVIDER=ffmpeg_motion

# =====================================================================
# OPTIONAL PROVIDERS
# =====================================================================

# ---- Runway (paid; optional future upgrade for generative video/images)
# VIDEO_PROVIDER=runway, VIDEO_MODEL=gen4.5 | veo3.1 | veo3.1_fast
# IMAGE_PROVIDER=runway, IMAGE_MODEL=gen4_image | gen4_image_turbo
VIDEO_PROVIDER_API_KEY=
VIDEO_MODEL=
IMAGE_PROVIDER_API_KEY=
# Fallback video provider: ffmpeg_motion | runway | none
VIDEO_FALLBACK_PROVIDER=none
VIDEO_FALLBACK_MODEL=

# ---- Alternative / fallback voice: azure | elevenlabs | none
# Leave VOICE_PROVIDER empty to let SPEECH_KEY pick Azure.
VOICE_PROVIDER=
VOICE_PROVIDER_API_KEY=
VOICE_FALLBACK_PROVIDER=none
VOICE_FALLBACK_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_MALE_VOICE_IDS=
ELEVENLABS_FEMALE_VOICE_IDS=

# ---- Music and sound effects (ElevenLabs): elevenlabs | none
MUSIC_PROVIDER=none
MUSIC_PROVIDER_API_KEY=
SFX_PROVIDER=none
SFX_PROVIDER_API_KEY=

# ---- Lip sync (sync.): sync | none
LIPSYNC_PROVIDER=none
LIPSYNC_PROVIDER_API_KEY=
LIPSYNC_MODEL=lipsync-2

# ---- Pipeline tuning
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=2000
PROVIDER_POLL_INTERVAL_MS=5000
PROVIDER_TASK_TIMEOUT_SEC=1800
IMAGE_CONCURRENCY=2
VIDEO_CONCURRENCY=2
VOICE_CONCURRENCY=4
AUDIO_CONCURRENCY=3
WORKER_CONCURRENCY=1

# ---- Limits
MAX_SCRIPT_CHARS=60000
RATE_LIMIT_GENERATIONS_PER_HOUR=10
RATE_LIMIT_AUTH_PER_15MIN=20
